{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perrylink.github.io/dsh-attention/bench-pack.schema.json",
  "title": "DSH Attention Bench Pack",
  "description": "A versioned set of capability tasks, candidate plugins, and signed results. A pack with an empty results array is a prior-only pack; consumers must label it as such.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "observedAt",
    "tasks",
    "plugins",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "dsh-attention/bench-pack/v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plugin"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "title",
        "intent",
        "keywords",
        "prompt",
        "checks",
        "model",
        "harness",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sha256"
          ],
          "properties": {
            "kind": {
              "enum": [
                "workspace",
                "image",
                "file",
                "none"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "answer-contains",
                  "file-exists",
                  "file-equals",
                  "command-exit-zero",
                  "no-clarifying-question",
                  "judge-rubric"
                ]
              },
              "value": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "rubric": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "status": {
          "enum": [
            "draft",
            "pilot",
            "ready",
            "retired"
          ]
        },
        "brief": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "author",
        "surface",
        "status",
        "license",
        "repo",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "frozen",
            "archived",
            "retired"
          ]
        },
        "license": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "format": "uri"
        },
        "npm": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lastPush",
            "verification",
            "observedAt"
          ],
          "properties": {
            "installs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "npm7d": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "stars": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "lastPush": {
              "type": "string",
              "format": "date"
            },
            "verification": {
              "enum": [
                "none",
                "doctor",
                "certified"
              ]
            },
            "docs": {
              "enum": [
                "basic",
                "full"
              ]
            },
            "observedAt": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "runId",
        "taskId",
        "plugin",
        "arm",
        "model",
        "harness",
        "outcome",
        "sessionHash",
        "runner"
      ],
      "properties": {
        "schema": {
          "const": "dsh-attention/bench-result/v1"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "arm": {
          "enum": [
            "with",
            "without"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "checks"
          ],
          "properties": {
            "pass": {
              "type": "boolean"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "pass"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "pass": {
                    "type": "boolean"
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "toolErrors": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "sessionHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "keyId": {
              "type": "string"
            },
            "replicated": {
              "type": "boolean"
            }
          }
        },
        "signature": {
          "type": "string"
        }
      }
    }
  }
}
